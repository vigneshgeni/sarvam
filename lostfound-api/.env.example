# sarvam-lf-api local env. Never commit a real .env or secret.
# Copy to .env for local runs. Cloud Run reads LF_ID_PEPPER and LF_FIELD_KEY from Secret Manager.

PROJECT=sarvam-510715
MODEL=gemini-3.7-flash
VERTEX_LOCATION=global
PORT=43123

LF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:41777,http://127.0.0.1:41777,http://localhost:43123,http://127.0.0.1:43123
LF_COLLECTION_PREFIX=dev_
LF_STORE=memory

# Required in production (Secret Manager). Optional locally when LF_DEMO_MODE=true.
# LF_ID_PEPPER=
# LF_FIELD_KEY=

LF_DEMO_MODE=true
LF_AADHAAR_LITE=false
LF_PUBLIC_LOST_FEED=false
LF_MATCH_THRESHOLD=45
LF_POST_TTL_DAYS=90
