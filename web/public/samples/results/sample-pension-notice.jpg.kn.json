  "summary": [
    "ಜಿಲ್ಲಾ ಸಮಾಜ ಕಲ್ಯಾಣಾಧಿಕಾರಿಗಳ ಕಚೇರಿಯ ಈ ಸೂಚನೆಯು Smt. Kamala Devi ಅವರಿಗೆ ತಮ್ಮ ವೃದ್ಧಾಪ್ಯ ವೇತನದ ಬಗ್ಗೆ ತಿಳಿಸುತ್ತದೆ.",
    "ಪಿಂಚಣಿದಾರರು ತಮ್ಮ ಜೀವಿತ ಪ್ರಮಾಣಪತ್ರವನ್ನು (Life Certificate) 30.11.2026 ರೊಳಗೆ ಪಿಂಚಣಿ ನೀಡುವ ಬ್ಯಾಂಕ್ ಶಾಖೆ ಅಥವಾ ಸಾಮಾನ್ಯ ಸೇವಾ ಕೇಂದ್ರದಲ್ಲಿ (CSC) ಸಲ್ಲಿಸಬೇಕು.",
    "ಜೀವಿತ ಪ್ರಮಾಣಪತ್ರವನ್ನು ಸಮಯಕ್ಕೆ ಸರಿಯಾಗಿ ಸಲ್ಲಿಸದಿದ್ದರೆ, ಡಿಸೆಂಬರ್ 2026 ರಿಂದ ರೂ. 1,200 ಪಿಂಚಣಿ ಹಣವನ್ನು ತಡೆಹಿಡಿಯಲಾಗುತ್ತದೆ."
  ],
  "spoken_summary": "ಇದು ವೃದ್ಧಾಪ್ಯ ವೇತನ ಯೋಜನೆ (Old Age Pension Scheme) ಪಿಂಚಣಿದಾರರ ಸೂಚನೆಗೆ ಸಂಬಂಧಿಸಿದ ಅಧಿಕೃತ ದಾಖಲೆಯಾಗಿದೆ. ದಯವಿಟ್ಟು ಮುಖ್ಯ ವಿವರಗಳನ್ನು ಗಮನಿಸಿ. 30 ನವೆಂಬರ್ 2026 ರೊಳಗೆ ನಿಮ್ಮ ಆಧಾರ್ ಕಾರ್ಡ್ ಮತ್ತು ಪಿಂಚಣಿ ಪುಸ್ತಕದೊಂದಿಗೆ ನಿಮ್ಮ ಪಿಂಚಣಿ ನೀಡುವ ಬ್ಯಾಂಕ್ ಶಾಖೆ ಅಥವಾ ಯಾವುದೇ ಸಾಮಾನ್ಯ ಸೇವಾ ಕೇಂದ್ರದಲ್ಲಿ (CSC) ಜೀವಿತ ಪ್ರಮಾಣಪತ್ರವನ್ನು ಸಲ್ಲಿಸಿ, ಮತ್ತು ಸ್ವೀಕೃತಿ ರಶೀದಿಯನ್ನು ಪಡೆದುಕೊಳ್ಳಿ.",
  "actions": [
    {
      "text": "ನಿಮ್ಮ ಆಧಾರ್ ಕಾರ್ಡ್ ಮತ್ತು ಪಿಂಚಣಿ ಪುಸ್ತಕದೊಂದಿಗೆ ನಿಮ್ಮ ಪಿಂಚಣಿ ನೀಡುವ ಬ್ಯಾಂಕ್ ಶಾಖೆ ಅಥವಾ ಯಾವುದೇ ಸಾಮಾನ್ಯ ಸೇವಾ ಕೇಂದ್ರದಲ್ಲಿ (CSC) ಜೀವಿತ ಪ್ರಮಾಣಪತ್ರವನ್ನು ಸಲ್ಲಿಸಿ, ಮತ್ತು ಸ್ವೀಕೃತಿ ರಶೀದಿಯನ್ನು ಪಡೆದುಕೊಳ್ಳಿ.",
